<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="fa-solid fa-desktop"></i> Lista de Productos</h1>
    <a href="/productos/crear" class="btn btn-success">
        <i class="fa-solid fa-square-plus"></i>Nuevo Producto
    </a>
</div>

<% if (productos.length === 0) { %>
    <div class="alert alert-info text-center">
        <h4>No hay productos registrados</h4>
        <p>¡Agrega tu primer producto!</p>
    </div>
<% } else { %>
    <div class="product-grid">
        <% productos.forEach(producto => { %>
        <div class="col">
            <div class="card producto-card h-100 shadow">
                <!-- Imagen del producto -->
                <% if (producto.imagen) { %>
                    <img src="/images/<%= producto.imagen %>" 
                         class="card-img-top" 
                         alt="<%= producto.nombre %>">
                <% } else { %>
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center">
                        <span class="text-white fs-1">🖼️</span>
                    </div>
                <% } %>

                <div class="card-body">
                    <h5 class="card-title">
                        <%= producto.nombre %>
                    </h5>

                    <p class="mb-1">
                        <strong>Categoría:</strong>
                        <%= producto.categoria %>
                    </p>

                    <p class="mb-1">
                        <strong>Marca:</strong>
                        <%= producto.marca %>
                    </p>

                    <p class="mb-1">
                        <strong>Stock:</strong>

                        <span class="<%= producto.stock > 0 ? 'stock-disponible' : 'stock-agotado' %>">
                            <%= producto.stock %>
                        </span>
                    </p>
                    
                    <h4 class="text-primary">
                        $<%= producto.precio.toFixed(2) %>
                    </h4>

                    <div class="estado-producto <%= producto.activo ? 'activo' : 'inactivo' %>">
                        <i class="fa-solid <%= producto.activo ? 'fa-circle-check' : 'fa-circle-xmark' %>"></i>
                        <span><%= producto.activo ? 'Activo' : 'Inactivo' %></span>
                    </div>
                </div>

                <div class="card-footer bg-white border-top-0">
                    <div class="d-flex gap-2">

                        <a href="/productos/editar/<%= producto.id %>"
                        class="btn btn-warning btn-sm flex-fill">
                            <i class="fa-solid fa-pen-to-square"></i> Editar
                        </a>

                        <% if (producto.activo) { %>

                                <form
                                    id="form-desactivar-<%= producto.id %>"
                                    action="/productos/eliminar/<%= producto.id %>"
                                    method="POST"
                                    class="flex-fill">

                                <button
                                    type="button"
                                    class="btn btn-danger btn-sm w-100"
                                    onclick="confirmarDesactivacion(<%= producto.id %>)">

                                    <i class="fa-solid fa-toggle-off"></i> Desactivar

                                </button>

                            </form>

                        <% } else { %>

                                <form
                                    id="form-activar-<%= producto.id %>"
                                    action="/productos/activar/<%= producto.id %>"
                                    method="POST"
                                    class="flex-fill">

                                    <button
                                        type="button"
                                        class="btn btn-success btn-sm w-100"
                                        onclick="confirmarActivacion(<%= producto.id %>)">

                                        <i class="fa-solid fa-toggle-on"></i> Activar

                                    </button>

                                </form>

                        <% } %>

                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
<% } %>

<%- include('../partials/footer') %>