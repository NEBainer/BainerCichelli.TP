<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📦 Lista de Productos</h1>
    <a href="/productos/crear" class="btn btn-success">
        ➕ Nuevo Producto
    </a>
</div>

<% if (productos.length === 0) { %>
    <div class="alert alert-info text-center">
        <h4>No hay productos registrados</h4>
        <p>¡Agrega tu primer producto!</p>
    </div>
<% } else { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <% productos.forEach(producto => { %>
        <div class="col">
            <div class="card producto-card h-100 shadow">
                <!-- Imagen del producto -->
                <% if (producto.imagen) { %>
                    <img src="/images/<%= producto.imagen %>" 
                         class="card-img-top" 
                         alt="<%= producto.nombre %>">
                <% } else { %>
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center">
                        <span class="text-white fs-1">🖼️</span>
                    </div>
                <% } %>

                <div class="card-body">
                    <h5 class="card-title">
                        <%= producto.nombre %>
                    </h5>

                    <p class="mb-1">
                        <strong>Categoría:</strong>
                        <%= producto.categoria %>
                    </p>

                    <p class="mb-1">
                        <strong>Marca:</strong>
                        <%= producto.marca %>
                    </p>

                    <p class="mb-1">
                        <span class="badge <%= producto.stock > 0 ? 'bg-success' : 'bg-danger' %>">
                            Stock: <%= producto.stock %>
                        </span>
                    </p>

                    <h4 class="text-primary">
                        $<%= producto.precio.toFixed(2) %>
                    </h4>

                    <span class="badge <%= producto.activo ? 'bg-success' : 'bg-danger' %>">
                        <%= producto.activo ? 'Activo' : 'Inactivo' %>
                    </span>
                </div>

                <div class="card-footer bg-white border-top-0">
                    <div class="d-flex gap-2">

                        <a href="/productos/editar/<%= producto.id %>"
                        class="btn btn-warning btn-sm flex-fill">
                            ✏️ Editar
                        </a>

                        <% if (producto.activo) { %>

                            <form
                                action="/productos/eliminar/<%= producto.id %>"
                                method="POST"
                                class="flex-fill"
                                onsubmit="return confirm('¿Desactivar este producto?')">

                                <button
                                    type="submit"
                                    class="btn btn-danger btn-sm w-100">

                                    🗑️ Desactivar

                                </button>

                            </form>

                        <% } else { %>

                            <form
                                action="/productos/activar/<%= producto.id %>"
                                method="POST"
                                class="flex-fill"
                                onsubmit="return confirm('¿Activar este producto?')">

                                <button
                                    type="submit"
                                    class="btn btn-success btn-sm w-100">

                                    🔄 Activar

                                </button>

                            </form>

                        <% } %>

                    </div>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
<% } %>

<%- include('../partials/footer') %>