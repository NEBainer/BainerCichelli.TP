<%- include('partials/header') %>
<div class="alert alert-danger">
    <h1><%= message || 'Error' %></h1>
    <% if (typeof error !== 'undefined' && error && error.status) { %>
        <h2><%= error.status %></h2>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.stack) { %>
        <pre><%= error.stack %></pre>
    <% } %>
</div>
<%- include('partials/footer') %>
