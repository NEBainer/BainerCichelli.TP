        </div>
        <!-- Modal de confirmación -->
        <div class="modal-overlay" id="modal-confirmacion">
            <div class="modal">

                <div class="modal__icon modal__icon--confirm">
                <i id="modal-icon" class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div class="modal__title" id="confirm-title">
                Confirmar acción
                </div>

                <div class="modal__body" id="confirm-body">
                ¿Estás seguro?
                </div>

                <div class="modal__actions">
                <button
                    class="btn btn-secondary"
                    onclick="cerrarModal('modal-confirmacion')">
                    Cancelar
                </button>

                <button
                    class="btn btn-primary"
                    id="confirm-btn">
                    Confirmar
                </button>
                </div>

            </div>
        </div>
        <div class="modal-overlay" id="modal-exito">
            <div class="modal">

                <div class="modal__icon">
                    <i
                        class="fa-solid fa-circle-check"
                        style="color:#22c55e;">
                    </i>
                </div>

                <div
                    class="modal__title"
                    id="success-title">

                    Operación exitosa

                </div>

                <div
                    class="modal__body"
                    id="success-body">

                    Acción realizada correctamente.

                </div>

            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

        <script>
        const currentPath = window.location.pathname;
        document.querySelectorAll('.nav-link').forEach(link => {
            if (link.getAttribute('href') === currentPath) link.classList.add('active');
        });

        const savedTheme =
            localStorage.getItem("theme") || "dark";

        document.documentElement.setAttribute(
            "data-theme",
            savedTheme
        );

        const themeButton =
            document.querySelector(".theme-toggle");

        if (themeButton) {

            themeButton.innerHTML =
                savedTheme === "dark"
                    ? '<i class="fa-solid fa-moon"></i>'
                    : '<i class="fa-solid fa-sun"></i>';
        }

        function abrirModal(id) {
            document.getElementById(id).classList.add("open");
        }

        function cerrarModal(id) {
            document.getElementById(id).classList.remove("open");
        }

        function mostrarConfirmacion(
            titulo,
            mensaje,
            callback
        ) {

            document.getElementById("confirm-title").textContent =
                titulo;

            document.getElementById("confirm-body").textContent =
                mensaje;

            const btn =
                document.getElementById("confirm-btn");

            btn.onclick = () => {

                cerrarModal("modal-confirmacion");

                callback();
            };

            abrirModal("modal-confirmacion");
        }

        function confirmarDesactivacion(id) {

            mostrarConfirmacion(
                "Desactivar producto",
                "El producto dejará de estar disponible para los clientes.",
                () => {
                    document
                        .getElementById(`form-desactivar-${id}`)
                        .submit();
                }
            );

        }

        function confirmarActivacion(id) {

            mostrarConfirmacion(
                "Activar producto",
                "El producto volverá a estar disponible para los clientes.",
                () => {
                    document
                        .getElementById(`form-activar-${id}`)
                        .submit();
                }
            );

        }

        function confirmarLogout() {

            mostrarConfirmacion(
                "Cerrar sesión",
                "Tu sesión actual será cerrada.",
                () => {
                    window.location.href = "/logout";
                }
            );

        }

        function mostrarExito(
            titulo,
            mensaje
        ) {

            document.getElementById(
                "success-title"
            ).textContent = titulo;

            document.getElementById(
                "success-body"
            ).textContent = mensaje;

            abrirModal("modal-exito");

            setTimeout(() => {

                cerrarModal("modal-exito");

            }, 2500);

        }

        function toggleTheme() {

            const current =
                document.documentElement.getAttribute("data-theme");

            const next =
                current === "dark"
                    ? "light"
                    : "dark";

            document.documentElement.setAttribute(
                "data-theme",
                next
            );

            localStorage.setItem(
                "theme",
                next
            );

            const themeButton =
                document.querySelector(".theme-toggle");

            if (themeButton) {

                themeButton.innerHTML =
                    next === "dark"
                        ? '<i class="fa-solid fa-moon"></i>'
                        : '<i class="fa-solid fa-sun"></i>';
            }
        }

        const params =
            new URLSearchParams(
                window.location.search
            );

        const success =
            params.get("success");

        if (success === "creado") {

            mostrarExito(
                "Producto creado",
                "El producto fue registrado correctamente."
            );

        }

        if (success === "editado") {

            mostrarExito(
                "Producto actualizado",
                "Los cambios fueron guardados correctamente."
            );

        }
        
        </script>

    </body>
</html>
